<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.ShopView"
             Title="Shop"
             NavigatedTo="ContentPage_NavigatedTo">
    <VerticalStackLayout Spacing="10" Padding="20">
        <Label 
            Text="Available Products"
            FontSize="24"
            HorizontalOptions="Center" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Entry Text="{Binding Query}" Placeholder="Search products..." Grid.Column="0"/>
            <Button Text="Search" Grid.Column="1" Clicked="SearchClicked"/>
        </Grid>

        <ListView
            ItemsSource="{Binding Path=Products}"
            SelectedItem="{Binding SelectedProduct}"
            SelectionMode="Single"
            HeightRequest="350"
            >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Padding="10" Margin="5,2" BorderColor="LightGray" CornerRadius="5">
                            <Label Text="{Binding Display}" VerticalOptions="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#e0e0ff" />
                                            <Setter Property="BorderColor" Value="#512BD4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Label Text="Quantity:" Margin="0,10,0,0"/>
        <Entry Text="{Binding Quantity}" Keyboard="Numeric"/>

        <Button Text="Add to Cart" Clicked="AddToCartClicked" Margin="0,10,0,0"/>
        <Button Text="View Cart" Clicked="ViewCartClicked" Margin="0,10,0,0"/>
        <Button Text="Main Menu" Clicked="MainMenuClicked" Margin="0,10,0,0"/>
    </VerticalStackLayout>
</ContentPage>