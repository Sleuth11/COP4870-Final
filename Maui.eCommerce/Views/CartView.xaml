<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.CartView"
             Title="Your Cart"
             NavigatedTo="ContentPage_NavigatedTo">
    <VerticalStackLayout Spacing="10" Padding="20">
        <Label 
            Text="Shopping Cart"
            FontSize="24"
            HorizontalOptions="Center" />

        <ListView
            ItemsSource="{Binding CartItems}"
            SelectedItem="{Binding SelectedCartItem}"
            SelectionMode="Single"
            HeightRequest="250"
            >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Padding="10" Margin="5,2" BorderColor="LightGray" CornerRadius="5">
                            <Label Text="{Binding Display}" VerticalOptions="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#e0e0ff" />
                                            <Setter Property="BorderColor" Value="#512BD4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Label Text="Update Quantity (0 to remove):" Margin="0,10,0,0"/>
        <Entry Text="{Binding UpdateQuantity}" Keyboard="Numeric"/>
        
        <Button Text="Update Quantity" Clicked="UpdateQuantityClicked" Margin="0,10,0,0"/>
        <Button Text="Remove Item" Clicked="RemoveItemClicked" Margin="0,10,0,0"/>

        <Label Text="{Binding SubtotalDisplay}" FontAttributes="Bold" Margin="0,10,0,0"/>
        <Label Text="{Binding TaxDisplay}" FontAttributes="Bold"/>
        <Label Text="{Binding TotalDisplay}" FontAttributes="Bold" FontSize="18"/>

        <Button Text="Continue Shopping" Clicked="ContinueShoppingClicked" Margin="0,10,0,0"/>
        <Button Text="Checkout" Clicked="CheckoutClicked" Margin="0,10,0,0" BackgroundColor="Green"/>
        <Button Text="Main Menu" Clicked="MainMenuClicked" Margin="0,10,0,0"/>
    </VerticalStackLayout>
</ContentPage>