<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.CheckoutView"
             Title="Checkout">
    <VerticalStackLayout Spacing="10" Padding="20">
        <Label 
            Text="Order Complete!"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Frame Padding="15" Margin="0,10,0,0" BorderColor="Gray">
            <ScrollView HeightRequest="350">
                <Label Text="{Binding ReceiptText}" FontFamily="Monospace"/>
            </ScrollView>
        </Frame>

        <Button Text="Return to Main Menu" Clicked="ReturnToMainClicked" Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>